<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>CameraTools</AssemblyName>
    <RootNamespace>CameraTools</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NuGetAudit>false</NuGetAudit>
    <RestoreAdditionalProjectSources></RestoreAdditionalProjectSources>
    <!-- Point these at a Genshin MelonLoader install (MelonLoader/net6 and MelonLoader/Il2CppAssemblies). -->
    <MelonLoaderNet6 Condition="'$(MelonLoaderNet6)' == ''">..\..\Output\GenshinDeckBundle\MelonLoader\net6</MelonLoaderNet6>
    <Il2CppAssemblies Condition="'$(Il2CppAssemblies)' == ''">..\..\Output\GenshinInteropBatchAll\interop</Il2CppAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(MelonLoaderNet6)\MelonLoader.dll" Private="false" />
    <Reference Include="$(MelonLoaderNet6)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(MelonLoaderNet6)\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(Il2CppAssemblies)\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(Il2CppAssemblies)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Il2CppAssemblies)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(Il2CppAssemblies)\Assembly-CSharp-firstpass.dll" Private="false" />
  </ItemGroup>
</Project>
